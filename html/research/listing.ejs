```{=html}
<div class="research">
<ul class="research-cards">
    <% for (const item of items) { %>
        <li class="research-card" <%=metadataAttrs(item) %>>
            <div class="research-card-thumb">
                <% if (item.image) { %>
                    <img src="<%- item.image %>" alt="">
                <% } else { %>
                    <div class="research-card-placeholder">
                        <%= item.categories ? item.categories[0] : 'Research' %>
                    </div>
                <% } %>
            </div>

            <div class="research-card-body">
                <div class="research-card-citation" data-ref="<%- encodeURIComponent(item['pub-info'].reference) %>">
                </div>
                <script>
                    (function() {
                        var el = document.currentScript.previousElementSibling;
                        el.innerHTML = '<p>' + decodeURIComponent(el.getAttribute('data-ref')) + '</p>';
                        el.removeAttribute('data-ref');
                    })();
                </script>

                <% if(item.categories) { %>
                <div class="research-card-categories">
                    <% for (const cat of item.categories) { %>
                        <span class="research-card-pill"><%= cat %></span>
                    <% } %>
                </div>
                <% } %>

                <% if (item.soundtrack || item.coffee) { %>
                <div class="research-card-pairings">
                    <% if (item.soundtrack) { %>
                    <span class="research-card-pairing">
                        <i class="fa-solid fa-music"></i>
                        <% if (item.soundtrack.url) { %>
                        <a href="<%- item.soundtrack.url %>" target="_blank" rel="noopener"><%= item.soundtrack.song %></a>
                        <% } else { %>
                        <%= item.soundtrack.song %>
                        <% } %>
                    </span>
                    <% } %>
                    <% if (item.coffee) { %>
                    <span class="research-card-pairing">
                        <i class="fa-solid fa-mug-hot"></i>
                        <%= item.coffee.drink %>
                    </span>
                    <% } %>
                </div>
                <% } %>

                <ul class="research-card-links">
                    <li class="research-card-link research-card-link-details">
                        <a href="<%- item.path %>" class="listing-name">
                            <i class="fa-solid fa-circle-info"></i> Details
                        </a>
                    </li>
                    <% var __order = {'Preprint':1,'Working Paper':1,'Final version':2,'Code':3,'Supplemental material':4,'Add to Zotero':5};
                       var __links = (item['pub-info'].links || []).slice().sort(function(a,b){ return (__order[a.name]||50) - (__order[b.name]||50); }); %>
                    <% if (__links.length) { %>
                        <% for (const link of __links) { %>
                    <li class="research-card-link">
                        <% if (link.local) { %>
                        <a href="<%- item.path.substring(0, item.path.lastIndexOf('/')) %>/<%- link.url %>">
                        <% } else { %>
                        <a href="<%- link.url %>">
                        <% } %>
                            <i class="<%- link.icon %>"></i> <%= link.name %>
                        </a>
                    </li>
                        <% } %>
                    <% } %>
                </ul>
            </div>
        </li>
    <% } %>
</ul>
</div>
```
